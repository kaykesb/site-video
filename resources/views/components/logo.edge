@link({
  route: 'home',
  'aria-label': 'RuralStream',
  class: 'inline-flex items-center gap-2 font-display text-xl font-bold tracking-tight text-texto-forte',
})
  <span class="logo-mark grid h-8 w-8 place-items-center rounded-lg bg-brand text-brand-contraste">
    @svg('lucide:play', { width: 16, height: 16 })
  </span>
  <span>Rural<span class="text-brand">Stream</span></span>
@end
