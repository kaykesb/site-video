<!DOCTYPE html>
<html
  lang="pt-BR"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap" rel="stylesheet" />
    <title>RuralStream</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <header class="header header--floating">
      <div class="header__inner">
        @!logo({ size: 28 })
        <div class="header__right">
          @!themeToggle()
          @if(auth?.user)
            @link({ route: 'dashboard', class: 'btn btn--primary btn--sm' })
            Início
            @end
          @else
            @link({ route: 'session.create', class: 'btn btn--ghost btn--sm' })
              Entrar
            @end
            @link({ route: 'new_account.create', class: 'btn btn--primary btn--sm' })
              Criar conta
            @end
          @end
        </div>
      </div>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
