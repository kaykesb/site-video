@layouts.app({ title: 'Vídeos · Administração' })
  <section class="mx-auto max-w-6xl px-4 py-8 md:px-8">
    <p class="text-xs font-bold uppercase tracking-wider text-brand">Administração</p>
    <header class="mt-1 flex flex-wrap items-end justify-between gap-4"><h1 class="text-3xl font-bold tracking-tight text-texto-forte">Vídeos</h1><p class="text-sm text-rural-400">{{ videos.length }} {{ videos.length === 1 ? 'vídeo' : 'vídeos' }}</p></header>
    <form action="/admin/videos"  method="get" class="mt-6 flex flex-col gap-3 sm:flex-row"><input name="q" value="{{query}}" placeholder="Buscar por título ou @autor" class="h-10 flex-1 rounded-lg border border-rural-800 bg-rural-900 px-3 text-sm placeholder:text-rural-500 focus:outline-none focus:ring-2 focus:ring-brand" />
      <button
        type="submit"
        class="h-10 rounded-lg bg-brand px-5 text-sm font-bold text-white hover:bg-brand-hover"
      >
        Buscar
      </button>
    </form>
    <div class="mt-3 overflow-x-auto rounded-xl border border-rural-800"><table class="w-full min-w-[900px] table-fixed text-left text-sm"><thead class="bg-rural-900 text-xs uppercase tracking-wider text-rural-400"><tr><th class="w-[35%] px-4 py-3">Vídeo</th><th class="w-[20%] px-4 py-3">Autor</th><th class="w-[10%] pl-4 pr-10 py-3 text-center">Views</th><th class="w-[25%] px-4 py-3 text-center">Publicado</th><th class="w-[10%]"></th></tr></thead><tbody class="divide-y divide-rural-800">
      @each(video in videos)
        <tr class="hover:bg-rural-900/70"><td class="px-4 py-3"><a href="/videos/{{ video.id }}" class="flex items-center gap-3">
          @if(video.thumbnailPath)
            <img src="{{ video.thumbnailPath }}" alt="" class="h-14 w-10 shrink-0 rounded object-cover" />
          @else
            <span class="grid h-14 w-10 shrink-0 place-items-center rounded bg-rural-800 text-rural-400">
              {{ svg('lucide:clapperboard', { width: 18, height: 18 }) }}
            </span>
          @end
        <span class="min-w-0"><span class="block max-w-xs truncate font-bold">{{ video.title }}</span><span class="text-xs text-rural-400">{{ video.duration ? Math.floor(video.duration / 60) + ':' + String(video.duration % 60).padStart(2, '0') : '—' }}</span></span></a></td><td class="truncate px-4 py-3 text-rural-300">{{ '@' + video.author.username }}</td><td class="pl-4 pr-10 py-3 text-center tabular-nums">{{ video.viewsCount }}</td><td class="px-4 py-3 whitespace-nowrap text-center text-rural-400">{{ video.createdAt?.toFormat('dd/LL/yyyy') || '—' }}</td><td class="px-4 py-3 text-right"><a href="/videos/{{ video.id }}" class="font-bold text-brand">Ver</a></td></tr>
      @end
    </tbody></table></div>
  </section>
@end
