@layouts.app({ title: 'Vídeos · Administração' })
  <section class="mx-auto max-w-6xl px-4 py-8 md:px-8">
    <p class="text-xs font-bold uppercase tracking-wider text-brand">Administração</p>
    <header class="mt-1 flex flex-wrap items-end justify-between gap-4"><h1 class="text-3xl font-bold tracking-tight text-texto-forte">Vídeos</h1><p class="text-sm text-rural-400">48 vídeos · 1,2 mi visualizações</p></header>
    <div class="mt-6 flex flex-col gap-3 sm:flex-row"><input placeholder="Buscar por título ou @autor" class="h-10 flex-1 rounded-lg border border-rural-800 bg-rural-900 px-3 text-sm placeholder:text-rural-500 focus:outline-none focus:ring-2 focus:ring-brand" /><select class="h-10 rounded-lg border border-rural-800 bg-rural-900 px-3 text-sm"><option>Todas as categorias</option><option>Agro</option><option>Natureza</option></select><select class="h-10 rounded-lg border border-rural-800 bg-rural-900 px-3 text-sm"><option>Toda visibilidade</option><option>Público</option><option>Não listado</option><option>Privado</option></select></div>
    <div class="mt-4 flex items-center justify-between rounded-lg bg-rural-900 px-4 py-3 text-sm"><span><strong>2</strong> selecionado(s)</span><button type="button" class="font-bold text-red-600 hover:underline">Remover selecionados</button></div>
    <div class="mt-3 overflow-x-auto rounded-xl border border-rural-800"><table class="w-full min-w-[900px] text-left text-sm"><thead class="bg-rural-900 text-xs uppercase tracking-wider text-rural-400"><tr><th class="px-4 py-3"><input type="checkbox" checked class="accent-brand" /></th><th class="px-4 py-3">Vídeo</th><th class="px-4 py-3">Autor</th><th class="px-4 py-3">Categoria</th><th class="px-4 py-3">Visibilidade</th><th class="px-4 py-3 text-right">Views</th><th class="px-4 py-3 text-right">Curtidas</th><th class="px-4 py-3">Publicado</th><th></th></tr></thead><tbody class="divide-y divide-rural-800">
      @each(video in [{title:'Colheita do milho no campo experimental',author:'@carlinhos.dev',category:'Agro',visibility:'Público',views:'8,2 mil',likes:'420',date:'12 nov 2026',color:'from-pink-600 to-rose-950'},{title:'Flexbox em 30 segundos',author:'@leti',category:'Programação',visibility:'Público',views:'16,1 mil',likes:'1,1 mil',date:'10 nov 2026',color:'from-sky-600 to-slate-950'},{title:'Trilha da mata atlântica do campus',author:'@mari.costa',category:'Natureza',visibility:'Não listado',views:'24,1 mil',likes:'2,4 mil',date:'08 nov 2026',color:'from-violet-700 to-slate-950'}])
        <tr class="hover:bg-rural-900/70"><td class="px-4 py-3"><input type="checkbox" class="accent-brand" /></td><td class="px-4 py-3"><a href="/videos/1" class="flex items-center gap-3"><span class="h-14 w-10 shrink-0 rounded bg-gradient-to-b {{ video.color }}"></span><span><span class="block max-w-xs truncate font-bold">{{ video.title }}</span><span class="text-xs text-rural-400">0:28 · ID 1</span></span></a></td><td class="px-4 py-3 text-rural-300">{{ video.author }}</td><td class="px-4 py-3 text-rural-300">{{ video.category }}</td><td class="px-4 py-3 text-rural-300">{{ video.visibility }}</td><td class="px-4 py-3 text-right tabular-nums">{{ video.views }}</td><td class="px-4 py-3 text-right tabular-nums">{{ video.likes }}</td><td class="px-4 py-3 whitespace-nowrap text-rural-400">{{ video.date }}</td><td class="px-4 py-3 text-right"><a href="/videos/1" class="font-bold text-brand">Ver</a></td></tr>
      @end
    </tbody></table></div>
    <div class="mt-4 flex items-center justify-between text-sm"><p class="text-rural-400">Página 1 de 5</p><div class="flex gap-2"><button class="rounded-lg border border-rural-800 px-3 py-2 opacity-40">Anterior</button><button class="rounded-lg border border-rural-800 px-3 py-2 hover:bg-rural-900">Próxima</button></div></div>
  </section>
@end
