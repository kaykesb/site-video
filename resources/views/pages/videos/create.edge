@layouts.app({ title: 'Enviar vídeo' })
  <section class="mx-auto max-w-6xl px-5 py-8 md:px-8">
    <p class="text-xs font-bold uppercase tracking-wider text-brand">Compartilhe com a comunidade</p>
    <h1 class="mt-1 text-3xl font-bold tracking-tight text-texto-forte">Enviar vídeo</h1>
    <p class="mt-2 text-sm text-rural-400">Publique um vídeo curto para outras pessoas assistirem.</p>

    @form({ action: '/videos', method: 'POST', enctype: 'multipart/form-data', class: 'mt-8 grid gap-8 md:grid-cols-[280px_minmax(0,1fr)]', 'x-data': '{ submitting: false }', 'x-on:submit': 'submitting = true' })
      <section>
        @field.root({ name: 'video' })
        <div x-data="{ videoUrl: null, duration: null }">
        <label for="video_input" class="flex aspect-[9/16] cursor-pointer flex-col items-center justify-center gap-3 rounded-xl border-2 border-dashed border-rural-700 bg-rural-900 p-6 text-center hover:border-brand">
          <template x-if="!videoUrl"><span class="flex flex-col items-center gap-3">{{ svg('lucide:upload-cloud', { width: 42, height: 42 }) }}<span class="font-bold">Selecionar vídeo</span><span class="text-xs text-rural-400">MP4, WebM, MOV ou MKV</span></span></template>
          <video x-show="videoUrl" x-bind:src="videoUrl" x-on:loadedmetadata="duration = Math.round($event.target.duration)" controls class="max-h-full max-w-full rounded-lg"></video>
        </label>
        <input id="video_input" name="video" type="file" accept="video/mp4,video/webm,video/quicktime,video/x-matroska" required class="sr-only" x-on:change="videoUrl = URL.createObjectURL($event.target.files[0])" />
        <input type="hidden" name="duration" x-bind:value="duration" />
        </div>
        @!field.error()
        @end
        @field.root({ name: 'duration' })
          @!field.error()
        @end
      </section>
      <section class="flex flex-col gap-5">
        @field.root({ name: 'title' })
          @!field.label({ text: 'Título' })
          @!input.control({ placeholder: 'Dê um título ao seu vídeo' })
          @!field.error()
        @end
        @field.root({ name: 'description' })
          @!field.label({ text: 'Descrição' })
          @!textarea.control({ placeholder: 'Conte sobre o vídeo', class: 'field__input', rows: 5, style: 'height: auto; padding: 12px;' })
          @!field.error()
        @end
        @field.root({ name: 'thumbnail' })
          @!field.label({ text: 'Imagem de capa (opcional)' })
          @!input.control({ type: 'file', accept: 'image/jpeg,image/png,image/webp' })
          @!field.error()
        @end
        <button type="submit" x-bind:disabled="submitting" x-text="submitting ? 'Publicando...' : 'Publicar vídeo'" class="mt-2 h-11 rounded-lg bg-brand px-6 text-sm font-bold text-white hover:bg-brand-hover">Publicar vídeo</button>
      </section>
    @end
  </section>
@end
