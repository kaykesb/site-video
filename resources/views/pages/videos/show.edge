@layouts.app({ title: `${video.title} · RuralStream` })
  <section class="relative flex min-h-[calc(100vh-4rem)] items-center justify-center bg-rural-900 px-4 py-8 text-rural-100 md:min-h-screen">
    <a href="/dashboard" aria-label="Voltar" class="absolute left-5 top-5 z-10 grid h-10 w-10 place-items-center rounded-full bg-black/50 text-white hover:bg-black/75">{{ svg('lucide:arrow-left', { width: 20, height: 20 }) }}</a>
    <div class="flex w-full max-w-6xl items-center justify-center">
      <div class="relative flex h-[90vh] max-h-[1000px] aspect-[9/16] items-center justify-center overflow-hidden rounded-xl border border-rural-800 bg-white shadow-sm">
        <video
          src="{{ video.videoPath }}"
          @if(video.thumbnailPath)
            poster="{{ video.thumbnailPath }}"
          @end
          controls
          class="h-full w-full object-contain"
        ></video>
      </div>
    </div>
    <div class="absolute bottom-6 left-6 max-w-xl text-rural-100 md:left-10">
      <p class="text-sm text-rural-400">{{ '@' + video.author.username }} · {{ video.viewsCount }} visualizações</p>
      <h1 class="mt-1 text-xl font-bold">{{ video.title }}</h1>
      <p class="mt-2 text-sm text-rural-300">{{ video.description || 'Sem descrição' }}</p>
    </div>
  </section>
@end
