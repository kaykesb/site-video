@layouts.auth({ centered: true, softBackground: true })
  <div class="mb-8 lg:hidden">
    @!logo()
  </div>
  <p class="text-xs font-bold uppercase tracking-wider text-brand">Boas-vindas de volta</p>
  <h1 class="mt-2 text-3xl font-bold tracking-tight text-texto-forte">Entrar</h1>
  <p class="mt-2 text-sm text-rural-400">Acesse sua conta para continuar.</p>
  @form({ route: 'session.store', method: 'POST', class: 'mt-8 flex flex-col gap-4', 'x-data': '{ submitting: false }', 'x-on:submit': 'submitting = true' })
    @field.root({ name: 'email' })
      @!field.label({ text: 'E-mail' })
      @!input.control({ type: 'email', autocomplete: 'username', placeholder: 'seu@email.com' })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Senha' })
      @!input.control({ type: 'password', autocomplete: 'current-password', placeholder: 'Sua senha' })
      @!field.error()
    @end
    @!button({ text: 'Entrar', type: 'submit', block: true, style: 'margin-top: 8px;', 'x-bind:disabled': 'submitting', 'x-text': "submitting ? 'Aguarde...' : 'Entrar'" })
  @end
  <p class="mt-6 text-center text-sm text-rural-400">
    Ainda não tem uma conta?
    @link({ route: 'new_account.create', class: 'font-bold text-brand hover:underline' })
      Criar conta
    @end
  </p>
@end
