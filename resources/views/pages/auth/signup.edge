@layouts.auth()
  <h1 class="auth__title">Crie sua conta</h1>
  @form({
    route: 'new_account.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'fullName' })
      @!field.label({ text: 'Nome completo' })
      @!input.control({ autocomplete: 'name', placeholder: 'Seu nome completo' })
      @!field.error()
    @end
    @field.root({ name: 'email' })
      @!field.label({ text: 'E-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'email',
        placeholder: 'voce@exemplo.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'username' })
      @!field.label({ text: 'Nome de usuário' })
      @!input.control({ placeholder: 'seu_usuario' })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Senha' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @field.root({ name: 'passwordConfirmation' })
      @!field.label({ text: 'Confirmar senha' })
      @!input.control({
        type: 'password',
        autocomplete: 'new-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Criar conta',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Aguarde...' : 'Criar conta'",
    })
  @end

  <p class="auth__foot">
    
    Já possui uma conta?

    @link({ route: 'session.create', class: 'il' })
      Entrar
    @end
  </p>
@end
